{
  "functions": {
    "api/report.js": {
      "maxDuration": 60
    },
    "api/exam.js": {
      "maxDuration": 60
    },
    "api/monthly.js": {
      "maxDuration": 60,
      "includeFiles": "{exam-bank/**,parent.html}"
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/monthly.html",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/admin/monthly.html",
      "permanent": false
    },
    {
      "source": "/teacher",
      "destination": "/admin/monthly.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/consult",
      "destination": "/consult.html"
    },
    {
      "source": "/parent",
      "destination": "/api/monthly?pp=1"
    },
    {
      "source": "/r",
      "destination": "/api/monthly?rv=1"
    }
  ]
}
